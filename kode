#include <WiFi.h>
#include <DHT.h>

// --- Konfigurasi WiFi ---
// Pastikan nama WiFi dan password di bawah ini sesuai persis dengan di HP Anda
const char* ssid = "mas boy";               
const char* password = "fuadgantengsekali"; 

// --- Konfigurasi Sensor ---
#define DHTPIN 4      // Sensor DHT dihubungkan ke pin D4
#define DHTTYPE DHT22 // Jenis sensor putih biasanya DHT22 (Jika error, ganti jadi DHT11)
#define LDRPIN 5      // Sensor Cahaya (LDR) dihubungkan ke pin D5

DHT dht(DHTPIN, DHTTYPE);

void setup() {
  // Memulai komunikasi untuk Serial Monitor pada baud rate 115200
  Serial.begin(115200); 
  pinMode(LDRPIN, INPUT);
  dht.begin();

  // Memenuhi kriteria wajib: Terhubung ke Internet (WiFi)
  Serial.print("Menghubungkan ke WiFi: ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);

  // Looping sampai ESP32 berhasil terkoneksi ke WiFi
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nBerhasil terhubung ke WiFi!");
  Serial.println("==================================");
}

void loop() {
  // Sensor DHT butuh jeda minimal 2 detik antar pembacaan agar stabil
  delay(2000); 

  // Membaca data dari sensor DHT dan LDR
  float suhu = dht.readTemperature();
  float kelembapan = dht.readHumidity();
  int statusCahaya = digitalRead(LDRPIN);
  
  // Logika sederhana: Modul LDR bernilai 1 (HIGH) saat gelap dan 0 (LOW) saat terang
  String kondisiCahaya = (statusCahaya == HIGH) ? "Gelap" : "Terang";

  // Memastikan data valid dan tidak ada error runtime
  if (isnan(suhu) || isnan(kelembapan)) {
    Serial.println("Gagal membaca sensor DHT! Cek kembali kabel Anda.");
    return;
  }

  // Menampilkan data pembacaan sensor ke Serial Monitor
  Serial.print("Suhu: ");
  Serial.print(suhu);
  Serial.print(" °C | Kelembapan: ");
  Serial.print(kelembapan);
  Serial.print(" % | Kondisi Ruangan: ");
  Serial.println(kondisiCahaya);
}
